#include <iostream>
using namespace std;

#define N 5
int q[N], f = -1, r = -1;

void enq(int x) {
    if ((r + 1) % N == f) cout << "Overflow\n";
    else {
        if (f == -1) f = r = 0;
        else r = (r + 1) % N;
        q[r] = x;
    }
}

void deq() {
    if (f == -1) cout << "Underflow\n";
    else {
        cout << q[f] << " deleted\n";
        if (f == r) f = r = -1;
        else f = (f + 1) % N;
    }
}

int main() {
    enq(10); enq(20); enq(30);
    deq();
    enq(40);
}

