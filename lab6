#include <iostream>
using namespace std;

struct Node {
    int data;
    Node *next;
};

Node *f = NULL, *r = NULL;

void enq(int x) {
    Node *n = new Node{x, NULL};
    if (r == NULL) f = r = n;
    else r->next = n, r = n;
}

void deq() {
    if (f == NULL) cout << "Underflow";
    else {
        cout << f->data << " deleted";
        Node *t = f;
        f = f->next;
        if (f == NULL) r = NULL;
        delete t;
    }
}

int main() {
    enq(10); enq(20); enq(30);
    deq();
}

