#include <iostream>
using namespace std;

#define MAX 5

int q[MAX], front = -1, rear = -1;

void enqueue(int x) {
    if (rear == MAX - 1)
        cout << "Queue Overflow\n";
    else {
        if (front == -1) front = 0;
        q[++rear] = x;
    }
}

void dequeue() {
    if (front == -1)
        cout << "Queue Underflow\n";
    else {
        cout << "Deleted: " << q[front++] << endl;
        if (front > rear) front = rear = -1;
    }
}

void peek() {
    if (front == -1) cout << "Queue Empty\n";
    else cout << "Front: " << q[front] << endl;
}

void display() {
    if (front == -1) cout << "Queue Empty\n";
    else {
        for (int i = front; i <= rear; i++)
            cout << q[i] << " ";
        cout << endl;
    }
}

int main() {
    enqueue(10);
    enqueue(20);
    enqueue(30);
    display();
    dequeue();
    peek();
    display();
}

