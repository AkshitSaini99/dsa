#include <iostream>
#include <stack>
#include <algorithm>
using namespace std;

int priority(char c) {
    if (c == '^') return 3;
    if (c == '*' || c == '/') return 2;
    if (c == '+' || c == '-') return 1;
    return 0;
}

int main() {
    string s, ans = "";
    cin >> s;

    reverse(s.begin(), s.end());
    stack<char> st;

    for (char c : s) {
        if (isalnum(c))
            ans += c;
        else {
            while (!st.empty() && priority(st.top()) > priority(c)) {
                ans += st.top();
                st.pop();
            }
            st.push(c);
        }
    }

    while (!st.empty()) {
        ans += st.top();
        st.pop();
    }

    reverse(ans.begin(), ans.end());
    cout << ans;

    return 0;
}

