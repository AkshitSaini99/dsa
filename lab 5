#include <iostream>
using namespace std;

class Stack {
    int s[5], top;

public:
    Stack() {
        top = -1;
    }

    void push(int x) {
        if (top == 4)
            cout << "Overflow\n";
        else
            s[++top] = x;
    }

    void pop() {
        if (top == -1)
            cout << "Underflow\n";
        else
            cout << s[top--] << " popped\n";
    }

    void display() {
        for (int i = top; i >= 0; i--)
            cout << s[i] << " ";
    }
};

int main() {
    Stack st;

    st.push(10);
    st.push(20);
    st.push(30);

    st.display();
    cout << endl;
    st.pop();

    return 0;
}

