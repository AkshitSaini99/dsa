#include<iostream>
using namespace std;
struct N{int d;N*l,*r;};

N* ins(N*r,int x){
 if(!r)return new N{x,0,0};
 if(x<r->d)r->l=ins(r->l,x);
 else r->r=ins(r->r,x);
 return r;
}
bool search(N*r,int x){
 if(!r)return 0;
 if(r->d==x)return 1;
 return x<r->d?search(r->l,x):search(r->r,x);
}
int main(){
 N*r=0;int a[]={50,30,70,20,40};
 for(int x:a)r=ins(r,x);
 int x;cin>>x;cout<<(search(r,x)?"Found":"Not Found");
}

