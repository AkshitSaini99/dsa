#include<iostream>
using namespace std;
struct N{int d;N*l,*r;};

N* ins(N*r,int x){
 if(!r)return new N{x,0,0};
 if(x<r->d)r->l=ins(r->l,x);
 else r->r=ins(r->r,x);
 return r;
}
void in(N*r){if(r){in(r->l);cout<<r->d<<" ";in(r->r);}}
void pre(N*r){if(r){cout<<r->d<<" ";pre(r->l);pre(r->r);}}
void post(N*r){if(r){post(r->l);post(r->r);cout<<r->d<<" ";}}
int h(N*r){return r?1+max(h(r->l),h(r->r)):0;}
int cnt(N*r){return r?1+cnt(r->l)+cnt(r->r):0;}

int main(){
 N*r=0;int c,x;
 do{
  cout<<"\n1.Insert 2.Inorder 3.Preorder 4.Postorder 5.Height 6.Count 7.Exit\n";
  cin>>c;
  if(c==1){cin>>x;r=ins(r,x);}
  else if(c==2)in(r);
  else if(c==3)pre(r);
  else if(c==4)post(r);
  else if(c==5)cout<<h(r);
  else if(c==6)cout<<cnt(r);
 }while(c!=7);
}
