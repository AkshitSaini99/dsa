int height(N*r){
 if(!r)return 0;
 return 1+max(height(r->l),height(r->r));
}

//13
int count(N*r){
 if(!r)return 0;
 return 1+count(r->l)+count(r->r);
}

//14
int leaf(N*r){
 if(!r)return 0;
 if(!r->l&&!r->r)return 1;
 return leaf(r->l)+leaf(r->r);
}

