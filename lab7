//11
N* del(N*r,int x){
 if(!r)return r;
 if(x<r->d)r->l=del(r->l,x);
 else if(x>r->d)r->r=del(r->r,x);
 else{
  if(!r->l)return r->r;
  if(!r->r)return r->l;
  N*t=r->r;
  while(t->l)t=t->l;
  r->d=t->d;
  r->r=del(r->r,t->d);
 }
 return r;
}

